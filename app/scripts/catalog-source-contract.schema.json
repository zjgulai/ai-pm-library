{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalog Source Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedFrom",
    "collections",
    "validations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedFrom": {
      "type": "string",
      "minLength": 1
    },
    "collections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "requiredCategory",
          "publiclyVisible"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "requiredCategory": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "publiclyVisible": {
            "type": "boolean"
          }
        }
      }
    },
    "validations": {
      "type": "object",
      "required": [
        "nonNegativeIntegerFields",
        "requiredStringFields",
        "requiredStringArrayFields",
        "requiredTopLevelCollections",
        "sourceSkillCategories",
        "publicCatalogCategories"
      ],
      "additionalProperties": false,
      "properties": {
        "nonNegativeIntegerFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredStringFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredStringArrayFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredTopLevelCollections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceSkillCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publicSkillCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publicCatalogCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
